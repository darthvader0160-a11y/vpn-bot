# Образец файла .env. На сервере install.sh сам создаёт .env и заполняет всё, кроме первых двух строк.

# Токен бота от @BotFather
BOT_TOKEN=
# Твой Telegram ID (узнать: @userinfobot). Несколько админов — через запятую
ADMIN_IDS=

# Как называть сервис и сервер в V2Box
BRAND=Наш VPN
SERVER_NAME=🇳🇱 Нидерланды
MAX_USERS=50

# Ниже заполняет install.sh
SERVER_HOST=
PANEL_URL=
PANEL_TOKEN=
SUB_PORT=
SUB_PATH=
# Сайт, под который маскируется VPN (Reality). Менять можно и в панели.
REALITY_SNI=www.samsung.com
XHTTP_PORT=443
TCP_PORT=8443
